# ==============================================================================
# Trend Contenter — Environment Configuration Template (.env.example)
# ==============================================================================
# Quick Start:
#   cp .env.example .env
#   # Populate your API keys (minimum required: GEMINI_API_KEY or OPENAI_API_KEY, 
#   # POSTGRES_URI, and MONGODB_URI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'staging', or 'production'
APP_ENV=development

# JWT Authentication for API endpoints
JWT_SECRET=supersecretkey_change_in_production
JWT_EXPIRY_MINUTES=60

# Publicly reachable URL for this backend (required by Meta/Instagram/Facebook 
# Graph APIs so their media crawlers can fetch generated assets during publishing).
# For local dev, use an ngrok or Cloudflare tunnel (e.g., https://abc123.ngrok-free.app).
APP_PUBLIC_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 2. GOOGLE AI STUDIO & GEMINI / VEO SUITE (Primary Content Studio & Multimodal Engine)
# ------------------------------------------------------------------------------
# Direct Google AI Studio API key (starts with AIza... or AQ...)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Text & Strategic Concept Synthesis Model
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Multimodal Visual Artwork Generation Models (Imagen / Gemini Vision)
# Options: gemini-3.1-flash-image, gemini-2.0-flash, imagen-3.0-generate-002
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image

# Text & Multimodal Semantic Embedding Model
# Options: text-embedding-004, gemini-embedding-001
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google Veo Cinematic Video Generation
# Supports discrete durations: 4s, 6s, 8s (default: 6s)
# Options: veo-2.0-generate-001, veo-3.1-fast-generate-preview
VEO_MODEL=veo-2.0-generate-001

# Optional: Custom Google AI Studio or Vertex AI Base URL (leave blank for native Google endpoints)
GEMINI_BASE_URL=



# ------------------------------------------------------------------------------
# 3. ALTERNATE LLM PROVIDERS (For Autonomous Research & Multi-Agent Probing)
# ------------------------------------------------------------------------------
# Select primary LLM provider for LangGraph research nodes: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# OpenAI API Configuration (used if LLM_PROVIDER=openai or for Brand Radar probing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini

# Anthropic Claude Configuration (Optional, for Brand Radar multi-model probing)
ANTHROPIC_API_KEY=

# Multi-model Brand Radar Probing settings
LLM_PROBE_MAX_QUERIES=4
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MONITOR_PROVIDERS=openai,gemini,litellm

# ------------------------------------------------------------------------------
# 4. TREND RADAR & SEARCH INTELLIGENCE (SerpApi)
# ------------------------------------------------------------------------------
# Trends Provider: 'serpapi' for real-time breakout trends, or 'mock' for local offline testing
TRENDS_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_api_key_here
SERPAPI_BASE_URL=https://serpapi.com/search.json

# Geographic Region and Window (e.g., IN, US, GB)
TRENDS_GEO=IN
TRENDS_HOURS=4
TRENDS_ONLY_ACTIVE=true
TRENDS_LANGUAGE=en
TRENDS_POLL_INTERVAL_MINUTES=60
SERPAPI_NO_CACHE=false
TREND_QUALIFICATION_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 5. MULTI-PLATFORM SOCIAL LISTENING (SocialCrawl)
# ------------------------------------------------------------------------------
# Ingests real-world discussions across Reddit, X (Twitter), TikTok, Threads, and Instagram
SOCIAL_PROVIDER=socialcrawl
SOCIALCRAWL_API_KEY=your_socialcrawl_api_key_here
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev/v1
SOCIALCRAWL_PLATFORMS=reddit,twitter,threads,tiktok,instagram
SOCIALCRAWL_REQUEST_TIMEOUT_SECONDS=20
SOCIALCRAWL_MAX_CREDITS_PER_RUN=10
SOCIALCRAWL_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 6. VIDEO INTELLIGENCE & AUDIENCE QUESTIONS (YouTube Data API v3)
# ------------------------------------------------------------------------------
# YouTube Data API v3 key for video search & comment thread extraction
# (If left blank, will automatically fallback to GEMINI_API_KEY if enabled on Google Cloud)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_REGION_CODE=IN
YOUTUBE_MAX_SEARCH_RESULTS=10
YOUTUBE_MAX_COMMENT_VIDEOS=3
YOUTUBE_MAX_COMMENTS_PER_VIDEO=20
YOUTUBE_REQUEST_TIMEOUT_SECONDS=15
YOUTUBE_DAILY_QUOTA_BUDGET=10000

# ------------------------------------------------------------------------------
# 7. DATABASE PERSISTENCE & STORAGE
# ------------------------------------------------------------------------------
# PostgreSQL (Relational schema: investigations, opportunities, audiences, campaign_drafts)
POSTGRES_URI=postgresql+asyncpg://trend_user:trend_password@localhost:5432/trend_contenter

# MongoDB (Unstructured social evidence, crawler payloads, audit trails)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trend_contenter

# Google Cloud Storage (GCS) for media archiving & public asset serving (Optional)
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GCLOUD_SERVICE_KEY=

# ------------------------------------------------------------------------------
# 8. OMNI-CHANNEL PUBLISHING (Content Studio Stage 5: Social & Email)
# ------------------------------------------------------------------------------
# Instagram Business Publishing (Meta Graph API v22.0)
# Requires an Instagram Professional/Creator account connected to a Facebook Page
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v22.0

# Facebook Page Publishing (Meta Graph API v22.0)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v22.0

# Email Delivery Provider: 'sendgrid_sdk' or 'smtp_relay'
EMAIL_DELIVERY_PROVIDER=sendgrid_sdk

# SendGrid Official API Key & Sender Settings
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=campaigns@trendcontenter.com
SENDGRID_REPLY_TO=support@trendcontenter.com

# SMTP Relay Configuration (Alternative to SendGrid SDK, e.g. Amazon SES, Postmark, or SendGrid SMTP)
SMTP_RELAY_HOST=smtp.sendgrid.net
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=apikey
SMTP_RELAY_PASSWORD=
SMTP_RELAY_USE_STARTTLS=true

# ------------------------------------------------------------------------------
# 9. FRONTEND WEB CLIENT (Vite React Dashboard)
# ------------------------------------------------------------------------------
# Point web client to the backend FastAPI instance (default: http://127.0.0.1:8001/api/v1)
VITE_API_BASE=http://127.0.0.1:8001/api/v1
