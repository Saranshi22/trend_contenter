# ==========================================
# Trend Contenter - Environment Configuration
# ==========================================

# Google Gemini / Imagen API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Google Custom Search API (Optional for Google Search Image API)
# Get API Key: https://console.cloud.google.com/apis/credentials
# Create Custom Search Engine: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpApi API Key (Optional alternative for Google Image Search API - https://serpapi.com/)
SERPAPI_API_KEY=

# Default Models
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-3.1-pro-image
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-pro-image
VEO_MODEL=veo-2.0-generate-001
# Legacy fallback alias
IMAGEN_MODEL=gemini-3.1-pro-image
IMAGEN_EDIT_MODEL=gemini-3.1-pro-image

# Reranker Model: 'gemini' | 'clip' | 'hybrid'
DEFAULT_RERANKER_MODEL=hybrid

# Server Settings
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=content

